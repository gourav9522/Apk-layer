<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ApkLayer - Free Android App Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gold-glow { text-shadow: 0 0 15px rgba(234, 179, 8, 0.4); }
        .emerald-border { border-color: rgba(16, 185, 129, 0.3); }
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen p-4">
    <div class="max-w-3xl mx-auto py-6">
        
        <!-- Banner -->
        <div class="mb-3">
            <img id="bannerImg" src="https://archive.org/download/image_2a884fe73/image_2a884fe7~3.jpg" alt="Banner" class="w-full h-32 object-cover rounded-2xl border emerald-border shadow-lg cursor-pointer">
        </div>

        <!-- Disclaimer -->
        <div class="mb-6 p-3 bg-slate-900 border emerald-border rounded-xl text-[11px] text-slate-400">
            <strong class="text-amber-400">Disclaimer:</strong> For any app issues or removal, contact <span class="text-emerald-400">apklayer@gmail.com</span>.
        </div>

        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-extrabold text-emerald-400 gold-glow">ApkLayer</h1>
                <p class="text-xs text-amber-300">Trusted Global Android App Store</p>
            </div>
            <span id="adminBadge" class="hidden px-3 py-1 bg-red-500/20 text-red-400 border border-red-500/30 rounded-xl text-[10px] font-bold">Admin Unlocked</span>
        </div>

        <!-- Home View -->
        <div id="home-view">
            <input type="text" id="search" placeholder="Search apps by name..." onkeyup="filterApps()" 
                class="w-full p-4 rounded-xl bg-slate-900 border emerald-border text-white focus:outline-none mb-6 text-sm">

            <div id="debugBox" class="mb-4 p-3 bg-slate-900 border border-emerald-500/30 rounded-xl text-xs text-emerald-300 font-mono">
                Status: Loading Apps...
            </div>

            <div id="app-grid" class="grid grid-cols-1 gap-3"></div>
        </div>

        <!-- Detail View -->
        <div id="detail-view" class="hidden">
            <button onclick="goBack()" class="mb-6 px-4 py-2.5 bg-slate-900 border emerald-border rounded-xl text-xs font-bold text-slate-300">← Back to Store</button>
            
            <div id="app-detail-content" class="bg-slate-900 border emerald-border p-6 rounded-3xl mb-6"></div>

            <!-- ADMOLLO INTERSTITIAL AD CONTAINER -->
            <div class="my-4 flex justify-center">
                <div class="admoloInterstitial"
                data-publisher="eyJpdiI6IlVraWFMUlF6eVNiQXdvUTJDbVc5TXc9PSIsInZhbHVlIjoiV29zbTlFWUFJTnhqV3QwNTZSRzc2UT09IiwibWFjIjoiZjY1ZWU3ZDVjYmQxMzUxY2I5N2U2OTI5NzY1NTI3YzI0NTcyYjVlNjE3MzQ4MTZjZWQ4OGM1YTEwYWZmOTliZSIsInRhZyI6IiJ9"
                data-adsize="interstitial"></div>
            </div>

            <div class="mt-8">
                <h3 class="text-xs font-bold text-amber-400 mb-4 uppercase">Related Apps</h3>
                <div id="related-apps-grid" class="grid grid-cols-1 gap-3"></div>
            </div>
        </div>

    </div>

    <!-- ADMOLLO MAIN SCRIPT (Hamesha body ke bilkul ant me lagani hai taaki error na aaye) -->
    <script class="admoloScript" src="https://cdn.admolo.com/assets/ads/ad.js" async></script>

    <!-- App Logic Script -->
    <script>
        const FIREBASE_DB_URL = "https://apk-layer-default-rtdb.firebaseio.com/apps";
        let allApps = [];
        let isAdminUnlocked = false;
        let bannerClicks = 0;

        // Admin Unlock via 5 clicks on banner (Password: 9522)
        document.getElementById('bannerImg').addEventListener('click', () => {
            bannerClicks++;
            if (bannerClicks >= 5) {
                bannerClicks = 0;
                let pass = prompt("Enter Admin Password:");
                if (pass === "9522") {
                    isAdminUnlocked = true;
                    document.getElementById('adminBadge').classList.remove('hidden');
                    alert("Admin Unlocked!");
                    displayApps(allApps);
                }
            }
        });

        // Load Apps from Firebase
        function initStore() {
            const debugBox = document.getElementById('debugBox');
            fetch(FIREBASE_DB_URL + ".json")
                .then(res => res.json())
                .then(data => {
                    if (data) {
                        debugBox.innerText = "Status: Connected Successfully!";
                        allApps = Object.entries(data).map(([key, val]) => ({ ...val, fbKey: key })).reverse();
                    } else {
                        debugBox.innerText = "Status: Connected, but Database is Empty.";
                    }
                    displayApps(allApps);
                    checkRoute();
                })
                .catch(err => {
                    debugBox.innerText = "Error loading apps: " + err.message;
                });
        }

        function displayApps(apps) {
            const grid = document.getElementById('app-grid');
            if (apps.length === 0) {
                grid.innerHTML = '<div class="p-4 bg-slate-900 border emerald-border rounded-xl text-center text-xs text-slate-400">No apps found.</div>';
                return;
            }
            grid.innerHTML = apps.map(app => `
                <div class="flex items-center justify-between p-4 bg-slate-900 rounded-2xl border emerald-border">
                    <div onclick="openApp('${app.id}')" class="flex items-center gap-4 flex-1 cursor-pointer">
                        <img src="${app.logoUrl}" class="w-14 h-14 rounded-2xl object-cover bg-slate-950 border emerald-border">
                        <div>
                            <h2 class="text-base font-bold text-slate-100">${app.appName}</h2>
                            <p class="text-xs text-amber-300">Ver: ${app.version || '1.0'} • ${app.size || 'APK'}</p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        ${isAdminUnlocked ? `<button onclick="deleteApp('${app.fbKey}', '${app.appName}')" class="px-3 py-2 bg-red-600/20 text-red-400 rounded-xl text-xs font-bold border border-red-500/30">Delete</button>` : ''}
                        <button onclick="openApp('${app.id}')" class="px-4 py-2 bg-emerald-600/20 text-emerald-400 rounded-xl text-xs font-bold border border-emerald-500/30">View</button>
                    </div>
                </div>
            `).join('');
        }

        function deleteApp(fbKey, name) {
            if (prompt("Enter password to delete (9522):") !== "9522") return;
            fetch(`${FIREBASE_DB_URL}/${fbKey}.json`, { method: 'DELETE' })
                .then(res => { if(res.ok) { alert("Deleted!"); location.reload(); } });
        }

        function filterApps() {
            let q = document.getElementById('search').value.toLowerCase();
            displayApps(allApps.filter(a => a.appName.toLowerCase().includes(q)));
        }

        function openApp(id) {
            window.location.hash = `app=${id}`;
            renderDetail(id);
        }

        function renderDetail(id) {
            let app = allApps.find(a => a.id == id);
            if (!app) return goBack();
            
            document.getElementById('home-view').classList.add('hidden');
            document.getElementById('detail-view').classList.remove('hidden');

            document.getElementById('app-detail-content').innerHTML = `
                <div class="flex flex-col items-center text-center">
                    <img src="${app.logoUrl}" class="w-24 h-24 rounded-3xl object-cover bg-slate-950 border emerald-border mb-4">
                    <h2 class="text-2xl font-bold mb-1">${app.appName}</h2>
                    <p class="text-xs text-slate-300 mb-6">${app.description || ''}</p>
                    <a href="${app.archiveUrl}" class="w-full py-4 bg-emerald-600 rounded-2xl font-bold text-sm text-center text-white">Download APK</a>
                </div>
            `;
        }

        function goBack() {
            window.location.hash = '';
            document.getElementById('detail-view').classList.add('hidden');
            document.getElementById('home-view').classList.remove('hidden');
        }

        function checkRoute() {
            if (window.location.hash.includes('app=')) {
                let id = window.location.hash.split('=')[1];
                if (allApps.length > 0) renderDetail(id);
                else setTimeout(() => renderDetail(id), 500);
            }
        }

        window.onhashchange = checkRoute;
        initStore();
    </script>
</body>
</html>
